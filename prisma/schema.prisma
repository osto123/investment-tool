generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Apartment {
  id                   String   @id @default(cuid())
  address              String
  housingCompanyName   String
  sizeSqm              Decimal  @db.Decimal(6, 2)
  purchasePrice        Decimal  @db.Decimal(12, 2)
  purchaseDate         DateTime
  // Current recurring "yhtiövastike" rate, informational reference values.
  // Actual paid amounts are still logged as Transactions for cash-basis accounting.
  maintenanceFeeHoito  Decimal? @db.Decimal(10, 2)
  maintenanceFeePaaoma Decimal? @db.Decimal(10, 2)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenancies    Tenancy[]
  transactions Transaction[]
}

model Tenancy {
  id            String    @id @default(cuid())
  apartmentId   String
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  tenantName    String
  tenantContact String?
  monthlyRent   Decimal   @db.Decimal(10, 2)
  deposit       Decimal?  @db.Decimal(10, 2)
  leaseStart    DateTime
  leaseEnd      DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents TenancyDocument[]

  @@index([apartmentId])
}

model TenancyDocument {
  id        String   @id @default(cuid())
  tenancyId String
  tenancy   Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  label     String?
  url       String
  createdAt DateTime @default(now())

  @@index([tenancyId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  RENTAL_INCOME
  OTHER_INCOME
  MAINTENANCE_FEE
  REPAIR_COST
  MILEAGE
  INSURANCE
  OTHER_EXPENSE
}

model Transaction {
  id                 String              @id @default(cuid())
  apartmentId        String
  apartment          Apartment           @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  type               TransactionType
  category           TransactionCategory
  amount             Decimal             @db.Decimal(10, 2)
  date               DateTime
  description        String?
  receiptFileName    String?
  receiptStoragePath String?
  receiptMimeType    String?
  receiptSize        Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([apartmentId, date])
  @@index([apartmentId, category])
}
